# Application
NODE_ENV=development
PORT=3333
TRUST_PROXY=false

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/api_gym?schema=public"

# JWT
JWT_SECRET=troque-esta-chave-jwt-por-uma-sequencia-segura-com-mais-de-64-caracteres-unicos
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=30

# Security
BCRYPT_ROUNDS=10
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_TIMEWINDOW=60000
# CORS_ORIGIN=https://seu-frontend.example.com

# Cloudinary (para upload de arquivos)
CLOUDINARY_CLOUD_NAME=seu_cloud_name
CLOUDINARY_API_KEY=sua_api_key
CLOUDINARY_API_SECRET=seu_api_secret

# File Upload Limits
MAX_FILE_SIZE=5242880
MAX_PHOTO_SIZE=2097152

# Notifications Scheduler
ENABLE_NOTIFICATION_SCHEDULER=false
NOTIFICATION_TIMEZONE=America/Sao_Paulo
FRIDAY_PHOTO_REMINDER_CRON=0 9 * * 5
REAVALIACAO_REMINDER_CRON=0 8 * * *

# SMTP (email)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=dev@gforce.local
SMTP_FROM_NAME=G-Force

# Twilio WhatsApp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# External Exercise API
EXERCISE_API_BASE_URL=https://wger.de/api/v2

# External Food APIs
USDA_API_BASE_URL=https://api.nal.usda.gov/fdc/v1
USDA_API_KEY=
# Descomente se voce estiver rodando o TACO GraphQL localmente.
# TACO_API_BASE_URL=http://localhost:4000/graphql
TACO_API_KEY=
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_HANDLE=gforce.oficialbr
YOUTUBE_LATEST_CACHE_TTL_SECONDS=86400

# Lead Tracking
LEAD_TRACKING_SALT=troque-este-salt-por-uma-sequencia-segura-com-pelo-menos-16-caracteres

# LGPD / Privacidade
# Em producao, todos os campos abaixo sao obrigatorios.
# Use CPF para controlador pessoa fisica ou CNPJ para pessoa juridica.
PRIVACY_CONTROLLER_NAME=Nome ou razao social do controlador
PRIVACY_CONTROLLER_DOCUMENT_TYPE=CPF
PRIVACY_CONTROLLER_DOCUMENT=000.000.000-00
PRIVACY_CONTROLLER_ADDRESS=Endereco completo do controlador
PRIVACY_CONTACT_EMAIL=privacidade@seudominio.com
PRIVACY_DOCUMENT_VERSION=2026-06-07

# Compatibilidade temporaria: se PRIVACY_CONTROLLER_DOCUMENT nao estiver
# definido, PRIVACY_CONTROLLER_CNPJ ainda sera aceito como CNPJ.
# PRIVACY_CONTROLLER_CNPJ=00.000.000/0000-00

# ─────────────────────────────────────────────────────────────────────
# Seed e scripts locais (auditoria de segurança 004 — SEC-024/025)
# Sobrescreva em qualquer ambiente para não usar senhas triviais.
# Se não definidas, usam defaults APENAS para desenvolvimento local.
# SEED_ADMIN_PASSWORD=
# SEED_PROFESSOR_PASSWORD=
# SEED_ALUNO_PASSWORD=
# SEED_PROFESSOR_PADRAO_PASSWORD=
# MIGRATION_PLACEHOLDER_PASSWORD=

# Credenciais do Postgres no docker-compose (SEC-023).
# Definidas com default local; sobrescreva fora de desenvolvimento.
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=api_gym
